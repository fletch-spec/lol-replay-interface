node_modules/

# Champion portraits are downloaded from Data Dragon on first request and
# regenerate themselves. Keeping them out means the repo doesn't carry a copy
# of Riot's art that goes stale every patch.
app/cache/

# Local Claude Code state. launch.json and skills/ are project process, not
# local state - the skills are the invocable entry points to briefs/TRIAGE.md
# and the session-log convention, and a fresh clone that lost them would lose
# how this repo is worked. Everything else here (settings.local.json, caches,
# transcripts) stays local.
.claude/*
!.claude/launch.json
!.claude/skills/
